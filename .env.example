# ========================================================
# .env.example — Plataforma de Gestão de Carreira (Lobios)
# ========================================================
# Copie este arquivo para ".env" e preencha com os valores reais.
# O ".env" NUNCA deve ir pro Git (confira se está no .gitignore).
# Os valores reais são passados por fora (WhatsApp, cofre de senha).

# --------------------------------------------------------
# Supabase (Banco 1 — dados de RH)
# --------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# Só preencher se for rodar código de backend/admin.
# NUNCA usar no frontend, NUNCA commitar.
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------
# Firebase (Banco 2 — treinamentos, ponto, documentos)
# --------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=lobios-eniac.firebaseapp.com
FIREBASE_PROJECT_ID=lobios-eniac
FIREBASE_STORAGE_BUCKET=lobios-eniac.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Caminho pro arquivo JSON da conta de serviço do Firebase
# (só necessário se o backend usar o Admin SDK)
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
